{
  "name": "synstudios",
  "version": "1.1.0",
  "private": true,
  "description": "SynStudios — 2D sprite and 3D animation trial preview studio",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:mobile": "cross-env MOBILE_EXPORT=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "ws": "tsx server.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:debug": "powershell -ExecutionPolicy Bypass -File scripts/build-debug-apk.ps1",
    "android:debug:linux": "bash scripts/build-debug-apk.sh",
    "android:release": "powershell -ExecutionPolicy Bypass -File scripts/build-release-aab.ps1",
    "android:release:linux": "bash scripts/build-release-aab.sh",
    "package:releases": "bash scripts/package-releases.sh",
    "benchmark:compare": "python scripts/benchmark-compare.py",
    "benchmark:baseline": "python3 scripts/benchmark-compare.py --against-baseline",
    "benchmark:baselines": "python3 scripts/benchmark-compare.py --list-baselines",
    "taylor:playstore": "python scripts/taylor_playstore_team.py --mode production",
    "taylor:asset": "python3 scripts/taylor_asset_team.py",
    "taylor:launch": "bash scripts/taylor-launch-loop.sh"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
